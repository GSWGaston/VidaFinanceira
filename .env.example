# Copy to .env.local after applying the SQL migration in Supabase.
# Without these variables, new data is stored only in this browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use the Supabase secret/service_role key; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Generate a long random value and register it as X-VIDA-WEBHOOK-TOKEN in Pluggy.
PLUGGY_WEBHOOK_TOKEN=
